[Unit]
Description=Veil discord faucet bot service
Documentation=https://github.com/steel97/veilrustlib
After=network.target

[Service]
User=faucet
KillMode=process
WorkingDirectory=/home/faucet/veil-discord-faucet/
ExecStart=/home/faucet/veil-discord-faucet/veilfaucet
KillSignal=SIGKILL
TimeoutStopSec=0
Restart=always
TimeoutSec=300
RestartSec=5

[Install]
WantedBy=multi-user.target